# 複製為 .env 並填入值。此檔只列名稱與範例，不放任何真實機密。
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# 允許的前端網域，可用逗號分隔多個。production 必填。
CORS_ORIGIN=http://localhost:5173

# 資料庫。以下為 docker-compose 的本機專用可丟棄帳密；正式環境改用 Neon 的網址。
# DATABASE_URL：執行期連線（Neon 請用連線池網址）
DATABASE_URL=postgresql://store:store_local_only@localhost:5432/store_dev
# DIRECT_URL：migration 專用直連網址（本機與 DATABASE_URL 相同）
DIRECT_URL=postgresql://store:store_local_only@localhost:5432/store_dev
# TEST_DATABASE_URL：整合測試專用，主機必須是本機
TEST_DATABASE_URL=postgresql://store:store_local_only@localhost:5432/store_test

# 認證。JWT_ACCESS_SECRET 至少 32 字元；以 `openssl rand -hex 32` 產生。
# 以 change-me 開頭的值在 production 會被拒絕。
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
# access token 有效期，格式為數字加 s、m、h 或 d。預設 7d。
ACCESS_TOKEN_TTL=7d

# seed 建立管理員帳號用（見 specs/001-auth/spec.md）。密碼至少 8 字元，含英文與數字。
# 以下是與 README 測試帳號一致的示範值；部署到正式環境時請自行設定。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345

# 對外的 API 網址（含 https://，不含結尾斜線）。設定後，/api-docs 與 /openapi.json 的 servers 會使用它，
# Postman 匯入才會指向正確的伺服器。本機可省略，會使用目前的網域。
# PUBLIC_BASE_URL=https://your-api.onrender.com
